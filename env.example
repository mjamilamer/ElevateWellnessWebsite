# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://elevatewellnessnj.com

# Email transport (Resend — https://resend.com)
# Required: an API key from your Resend dashboard.
# If RESEND_API_KEY is unset, the contact + appointment forms return 503.
RESEND_API_KEY=
# Sender. Use the verified-domain address in production, e.g.
# "Elevate Wellness <appointments@elevatewellnessnj.com>".
# Until the domain is verified, leave blank → Resend's onboarding@resend.dev fallback.
MAIL_FROM=
# Recipient mailbox the practice manager monitors. Defaults to siteConfig.contact.email.
MAIL_TO=Info@elevatewellnessnj.com

# Google Search Console (meta tag verification)
GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Scheduler mode flag ----
# Master switch for the Google Calendar-backed scheduler. Leave unset/false to
# run in EMAIL-ONLY mode: the booking form still works end-to-end and emails the
# full request to info@ via Resend, but no Calendar event is created and
# availability is not checked against real events. Set to 'true' (and configure
# all four GOOGLE_* vars below) to turn the Calendar automation on.
SCHEDULER_CALENDAR_ENABLED=false

# ---- Google Calendar — appointment scheduling backend ----
# One-time setup, see /api/dev/google-oauth-setup (dev-only helper route).
#
# Steps:
#   1. Google Cloud Console → New Project → enable Calendar API.
#   2. APIs & Services → Credentials → Create OAuth client ID → Web application.
#   3. Add the dev redirect URI:
#        http://localhost:60125/api/dev/google-oauth-setup
#        (or whichever port `npm run dev` lands on)
#   4. Paste Client ID and Client Secret below into .env.local.
#   5. Start dev server → visit /api/dev/google-oauth-setup.
#   6. Click Authorize, sign in with info@elevatewellnessnj.com, grant Calendar.
#   7. The page prints a refresh token → copy it to GOOGLE_OAUTH_REFRESH_TOKEN.
#   8. In Google Calendar settings, open the "Practice Bookings" shared calendar
#      → copy its Calendar ID (xxx@group.calendar.google.com) → paste below.
#   9. Set all four env vars on Vercel Production and redeploy.
#
# Without these, /api/appointments/availability returns business-hour slots
# without checking real availability, and /api/appointments/request emails
# info@ without creating a Calendar event (manager books manually).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=
