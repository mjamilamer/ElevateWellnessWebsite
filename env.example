# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# Cal.com embed + webhooks
NEXT_PUBLIC_CAL_LINK=your-practice/consultation
CAL_WEBHOOK_SECRET=

# Turso (LibSQL) — same schema as former D1; run db/migrations/0001_initial_schema.sql
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Admin API (Bearer token, min 16 chars)
ADMIN_API_TOKEN=

# Google Search Console (meta tag verification)
GOOGLE_SITE_VERIFICATION=

# Optional: Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=
