{
  "name": "amermed-workers",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:dev": "wrangler deploy --env dev",
    "tail": "wrangler tail",
    "d1:create": "wrangler d1 create amermed-production",
    "d1:migrate": "wrangler d1 migrations apply amermed-production",
    "d1:migrate:dev": "wrangler d1 migrations apply amermed-dev --env dev"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "wrangler": "^3.80.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "hono": "^4.0.0",
    "zod": "^3.22.4"
  }
}
